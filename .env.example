# Port server API
PORT=3000

# Konfigurasi Database (GORM mendukung SQLite & PostgreSQL):
# 1. SQLite di dalam Docker Container:
# DB_DSN=/app/data/cinelog.db
# 2. SQLite di lokal host (tanpa Docker):
# DB_DSN=cinelog.db
# 3. PostgreSQL di localhost (tanpa Docker):
# DB_DSN=host=localhost user=postgres password=YOUR_DB_PASSWORD dbname=cinelog port=5432 sslmode=disable TimeZone=Asia/Jakarta
# 4. PostgreSQL di host diakses dari dalam Docker Container:
# DB_DSN=host=host.docker.internal user=postgres password=YOUR_DB_PASSWORD dbname=cinelog port=5432 sslmode=disable TimeZone=Asia/Jakarta
DB_DSN=host=localhost user=postgres password=YOUR_DB_PASSWORD dbname=cinelog port=5432 sslmode=disable TimeZone=Asia/Jakarta

# JWT Secret untuk autentikasi user
JWT_SECRET=super_secret_jwt_key_change_in_production

# API Key TMDB (The Movie Database v3)
TMDB_API_KEY=your_tmdb_api_key_v3

# Direktori penyimpanan upload gambar (opsional, default: ./uploads)
# UPLOAD_DIR=/app/uploads